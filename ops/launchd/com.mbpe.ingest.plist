<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.mbpe.ingest</string>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <key>ProgramArguments</key><array><string>/bin/sh</string><string>-c</string><string>__UV__ run python -m mbpe.data.ingest 2026-10-01 &amp;&amp; __UV__ run python -m mbpe.live.parity</string></array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>__INGEST_HOUR__</integer><key>Minute</key><integer>__INGEST_MINUTE__</integer></dict>
  <key>StandardOutPath</key><string>__REPO__/data/logs/ingest_parity.log</string>
  <key>StandardErrorPath</key><string>__REPO__/data/logs/ingest_parity.log</string>
</dict>
</plist>
