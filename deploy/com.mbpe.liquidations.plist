<?xml version="1.0" encoding="UTF-8"?>
<!-- macOS launchd agent for the long-running liquidation collector. NOT installed.
     Adjust the paths, copy to ~/Library/LaunchAgents/, then: launchctl load ~/Library/LaunchAgents/com.mbpe.liquidations.plist
     KeepAlive restarts it if it exits; a sleeping laptop stops collection (recorded as coverage gaps). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.mbpe.liquidations</string>
  <key>WorkingDirectory</key><string>/path/to/MBPE</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/uv</string><string>run</string><string>python</string>
    <string>-m</string><string>mbpe.sources.liquidations_live</string>
  </array>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/path/to/MBPE/data/logs/liquidations.log</string>
  <key>StandardErrorPath</key><string>/path/to/MBPE/data/logs/liquidations.log</string>
</dict>
</plist>
