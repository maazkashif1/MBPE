<?xml version="1.0" encoding="UTF-8"?>
<!-- macOS launchd agent: the hourly live run at minute 3. NOT installed. Adjust paths, copy to
     ~/Library/LaunchAgents/, then: launchctl load ~/Library/LaunchAgents/com.mbpe.live.plist
     A sleeping laptop skips hours (logged as missing decision times); a VM or always-on machine avoids that. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.mbpe.live</string>
  <key>WorkingDirectory</key><string>/path/to/MBPE</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/uv</string><string>run</string><string>python</string>
    <string>-m</string><string>mbpe.live.hourly_run</string>
  </array>
  <key>StartCalendarInterval</key><dict><key>Minute</key><integer>3</integer></dict>
  <key>StandardOutPath</key><string>/path/to/MBPE/data/logs/live.log</string>
  <key>StandardErrorPath</key><string>/path/to/MBPE/data/logs/live.log</string>
</dict>
</plist>
